<script type="text/javascript">
    $('.llang').on("click", function() {

        $("body").addClass("loading");
        let opts = {
                lines: 13,
                length: 28,
                width: 14,
                radius: 42,
                scale: 1,
                corners: 1,
                color: '#000',
                opacity: 0.25,
                rotate: 0,
                direction: 1,
                speed: 1,
                trail: 60,
                fps: 20,
                zIndex: 2e9,
                className: 'spinner',
                top: '50%',
                left: '50%',
                shadow: false,
                hwaccel: false,
                position: 'absolute',
            },
            target = document.getElementById('spinner'),
            spinner = new Spinner(opts).spin(target);
    });
</script>



<!-- Initialize Swiper -->
<script>
    /* Open */
    function openNav() {
        document.getElementById("myNav").style.height = "100%";
        $(".parent").hide();

        console.log('open press')
    }

    /* Close */
    function closeNav() {
        document.getElementById("myNav").style.height = "0%";
        $(".parent").show();

        console.log('close press')

    }


    function Showcat(s, d) {
        document.getElementById("myNav").style.height = "0%";
        $(".parent").show();


        user = false;

        var elmnt = document.getElementById(s);

        Element.prototype.documentOffsetTop = function() {
            return this.offsetTop + (this.offsetParent ? this.offsetParent.documentOffsetTop() : 0);
        };

        var top = elmnt.documentOffsetTop() - (window.innerHeight - (window.innerHeight -
            235 - 25));
        zenscroll.toY(top)
        swiper.slideTo(d)


    }





    var swiper = new Swiper('.swiper-container', {
        effect: 'coverflow',
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 'auto',
        slideToClickedSlide: true,
        spaceBetween: 15,
        coverflowEffect: {
            rotate: 0,
            stretch: 0,
            depth: 10,
            modifier: 10,
            slideShadows: false,
        },

    });

    var user = true;
    var start = false;

    console.log('b => ' + user)









    swiper.on('touchMove', function() {

        var y = $(".swiper-slide-active").data('index');
        var elmnt = document.getElementById(y);

        Element.prototype.documentOffsetTop = function() {
            return this.offsetTop + (this.offsetParent ? this.offsetParent.documentOffsetTop() : 0);
        };

        var top = elmnt.documentOffsetTop() - (window.innerHeight - (window.innerHeight -
            235 - 25));
        zenscroll.toY(top)


    });
    swiper.init();





    swiper.on('tap', function() {

        user = false;

        var y = $(".swiper-slide-active").data('index');
        var elmnt = document.getElementById(y);

        Element.prototype.documentOffsetTop = function() {
            return this.offsetTop + (this.offsetParent ? this.offsetParent.documentOffsetTop() : 0);
        };

        var top = elmnt.documentOffsetTop() - (window.innerHeight - (window.innerHeight -
            235 - 25));
        zenscroll.toY(top)


    });
    swiper.init();




    swiper.on('touchStart', function() {
        user = false;

    });
    swiper.init();






    $('.product').each(function(i, obj) {

        var s = $(this).data('info');
        var waypoint = new Waypoint({
            element: obj,
            handler: function(direction) {

                if (user == true) {

                    if (swiper.animating == false) {
                        swiper.slideTo(s)
                    }
                }


            },
            offset: ((window.innerHeight / (window.innerHeight -
                235 - 25)) * 100) * 2
        })


    });



    $(window).scroll(function() {
        start = true;


        clearTimeout($.data(this, 'scrollTimer'));
        $.data(this, 'scrollTimer', setTimeout(function() {


            user = true;

        }, 100))






    });


    $('.modal').modal({
        dismissible: true, // Modal can be dismissed by clicking outside of the modal
        opacity: .5, // Opacity of modal background
        inDuration: 300, // Transition in duration
        outDuration: 200, // Transition out duration
        startingTop: '4%', // Starting top style attribute
        endingTop: '10%', // Ending top style attribute
        ready: function(modal,
            trigger) { // Callback for Modal open. Modal and trigger parameters available.
            //  alert("Ready");
        },
        complete: function() { //alert('Closed');
        } // Callback for Modal close
    });
</script>



</html>
