}
        .header-item-container {
            text-align:center;
            height:85px;
            font-weight: 400;
            font-family: Almarai, Helvetica, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.42857;
            color: #927963;
            text-align: center;
            list-style: none;
            box-sizing: border-box;
            padding-right: 5px;
            padding-left: 5px;
        }

        .parent {
            margin-top: 250px;
            padding: 0;
            -webkit-transition: all .3s;
            transition: all .3s;
        }

        .main-header {
            position: fixed;
            top: 0;
            box-shadow: 0 0 20px rgba(0, 0, 0, .6);
            -webkit-transition: .4s;
            transition: .4s;
            right: 0;
            z-index: 99;
            width: 100%;
            background-color: #927963;
            border-bottom: #8E755E;
            border-bottom-style: solid;

        }

        .menu-item-image {
            object-fit: cover;
            border-radius: 5px;
            width: 80px!important;
            height: 80px!important;
        }

        .menu-item-image-inside {
            object-fit: cover;
            border-radius: 5px;
            width: 100%!important;
        }

        .item-image-container {
            padding: 0;
            float: left;
            margin-right: 15px;
            width:unset;
        }
        .item-image-container-ar {
            padding: 0;
            float: right;
            margin-left: 15px;
            margin-right: 0px;
        }

        .menu-item {
            background-color: hsla(0, 0%, 100%, .1);
            border-radius: 5px;
            max-height: 80px;
            box-shadow: -2px 5px 10px rgba(0, 0, 0, .1);
            margin: 10px 5px;
            position: relative;
        }
.item-title {
