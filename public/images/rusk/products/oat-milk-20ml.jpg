            max-height: 73px;
            margin-top: 2px;
            background: -webkit-linear-gradient(#333333 5%, hsla(0, 0%, 100%, 0));
            -webkit-background-clip: text;
            -webkit-text-fill-color: rgba(0, 0, 0, 0);
            word-wrap: break-word !important;
        }

        .menu-item-content {
            font-weight: lighter;
            font-size: 13px;
            max-height: 73px;
            margin-top: 2px;
            -webkit-background-clip: text;
            -webkit-text-fill-color: rgba(0, 0, 0, 0);
            word-wrap: break-word !important;
        }

        .menu-item-details {
            -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
