        .swiper-container {
            width: 100%;
        }

        .swiper-slide {
            min-height: 85px;
            background-position: center;
            background-size: cover;
            width: 85px;
            height: 85px;
            text-align: center;
            font-weight: 400;
            font-family: Almarai, Helvetica, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.42857;
            list-style: none;
            box-sizing: border-box;
            text-align: center;
            border-radius: 200px;
            transition: .4s;
            background-color: rgba(240, 248, 255, 0.212);
            transform: translate3d(0px, 0px, -100px) rotateX(0deg) rotateY(0deg) scale(1)!important;

        }


        .swiper-slide-t {
            min-height: 85px;
            background-position: center;
            background-size: cover;
            width: 85px;
            height: 85px;
            text-align: center;
            border-radius: 5px;
            margin: 5px auto;
            padding: 5px;

            font-weight: 400;
            font-family: Almarai, Helvetica, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.42857;
            list-style: none;
            box-sizing: border-box;
            text-align: center;
            border-radius: 5px;
            transition: .4s;
            background-color: rgba(240, 248, 255, 0.212);


        }

        .swiper-slide-active {

            background-color: rgba(240, 248, 255, 0.438);
            margin: 10px 15px;
            transform: translate3d(0px, 0px, 0px) rotateX(0deg) rotateY(0deg) scale(1)!important;


        }


